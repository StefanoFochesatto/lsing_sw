{
  "name": "colab-gpu-monitor",
  "displayName": "Google Colab GPU & Sessions Monitor",
  "description": "Visualize Google Colab Pro GPU sessions, compute units balance, SSH tunnels, and remote execution from VS Code.",
  "version": "0.1.0",
  "publisher": "stefano",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Remote Development",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "colab-sessions-container",
          "title": "Google Colab",
          "icon": "media/colab-icon.svg"
        }
      ]
    },
    "views": {
      "colab-sessions-container": [
        {
          "id": "colab.sessionsView",
          "name": "Active Sessions",
          "contextualTitle": "Sessions"
        },
        {
          "id": "colab.usageView",
          "name": "Compute Units & Usage",
          "contextualTitle": "Usage"
        },
        {
          "id": "colab.actionsView",
          "name": "Quick Actions",
          "contextualTitle": "Actions"
        }
      ]
    },
    "commands": [
      {
        "command": "colab.refresh",
        "title": "Refresh Colab Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "colab.openDashboard",
        "title": "Open Visual Colab Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "colab.sshConnect",
        "title": "Connect via SSH Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "colab.openWeb",
        "title": "Open in Colab Web UI",
        "icon": "$(globe)"
      },
      {
        "command": "colab.stopSession",
        "title": "Stop Session (Release VM)",
        "icon": "$(debug-stop)"
      },
      {
        "command": "colab.restartKernel",
        "title": "Restart Kernel",
        "icon": "$(debug-restart)"
      },
      {
        "command": "colab.viewLogs",
        "title": "View Session Logs",
        "icon": "$(output)"
      },
      {
        "command": "colab.newSessionT4",
        "title": "Launch New T4 GPU Session",
        "icon": "$(plus)"
      },
      {
        "command": "colab.newSessionL4",
        "title": "Launch New L4 GPU Session",
        "icon": "$(plus)"
      },
      {
        "command": "colab.newSessionA100",
        "title": "Launch New A100 High-RAM GPU Session",
        "icon": "$(plus)"
      },
      {
        "command": "colab.newSessionCustom",
        "title": "New Colab Session...",
        "icon": "$(add)"
      },
      {
        "command": "colab.login",
        "title": "Authenticate Colab CLI...",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "colab.refresh",
          "when": "view == colab.sessionsView || view == colab.usageView",
          "group": "navigation@1"
        },
        {
          "command": "colab.openDashboard",
          "when": "view == colab.sessionsView",
          "group": "navigation@2"
        },
        {
          "command": "colab.newSessionCustom",
          "when": "view == colab.sessionsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "colab.sshConnect",
          "when": "view == colab.sessionsView && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "colab.openWeb",
          "when": "view == colab.sessionsView && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "colab.restartKernel",
          "when": "view == colab.sessionsView && viewItem == session",
          "group": "inline@3"
        },
        {
          "command": "colab.stopSession",
          "when": "view == colab.sessionsView && viewItem == session",
          "group": "inline@4"
        },
        {
          "command": "colab.viewLogs",
          "when": "view == colab.sessionsView && viewItem == session",
          "group": "inline@5"
        }
      ]
    },
    "configuration": {
      "title": "Google Colab Monitor",
      "properties": {
        "colab.cliPath": {
          "type": "string",
          "default": "/home/stefano/.local/bin/colab",
          "description": "Path to the Google Colab CLI executable (e.g. colab or ~/.local/bin/colab)."
        },
        "colab.autoRefreshInterval": {
          "type": "number",
          "default": 20,
          "description": "Auto-refresh interval in seconds (set to 0 to disable automatic polling)."
        },
        "colab.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Display active Colab GPU sessions and Compute Units in the VS Code status bar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "bundle": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
